  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "browserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-freightctl-session"
      }
    },
    "schemas": {
      "Reference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "hash"
        ],
        "additionalProperties": false
      },
      "Participant": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "authority_revision": {
            "type": "integer",
            "minimum": 1
          },
          "namespace_root_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "actor_id",
          "authority_revision",
          "namespace_root_digest"
        ],
        "additionalProperties": false
      },
      "ProjectionRules": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "kind": {
            "type": "string",
            "const": "record_projection"
          },
          "engine": {
            "type": "string",
            "const": "freightctl-record-projection-v1"
          },
          "source_policy_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_kind": {
            "type": "string",
            "enum": [
              "csv",
              "json_records"
            ]
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "conversion": {
                  "type": "string",
                  "enum": [
                    "identity",
                    "text",
                    "normalize_lf"
                  ]
                },
                "missing": {
                  "type": "string",
                  "enum": [
                    "preserve",
                    "empty",
                    "null",
                    "error"
                  ]
                },
                "null": {
                  "type": "string",
                  "enum": [
                    "preserve",
                    "empty",
                    "missing",
                    "error"
                  ]
                },
                "empty": {
                  "type": "string",
                  "enum": [
                    "preserve",
                    "missing",
                    "null",
                    "error"
                  ]
                }
              },
              "required": [
                "source",
                "target",
                "conversion",
                "missing",
                "null",
                "empty"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 128
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824
          },
          "max_record_bytes": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1048576
          },
          "max_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "required": [
          "schema_version",
          "kind",
          "engine",
          "source_policy_hash",
          "output_kind",
          "columns",
          "max_bytes",
          "max_record_bytes",
          "max_rows",
          "timeout_seconds"
        ],
        "additionalProperties": false
      },
      "TypedWorkflow": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 3,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "maxItems": 0
          },
          "processing": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "const": "records.project",
                "type": "string"
              },
              "definition": {
                "$ref": "#/components/schemas/ProjectionRules"
              },
              "output_policy": {
                "$ref": "#/components/schemas/Reference"
              },
              "target_path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "definition",
              "output_policy",
              "target_path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "name",
          "steps",
          "processing"
        ],
        "additionalProperties": false
      },
      "Request": {
        "type": "object",
        "properties": {
          "workflow": {
            "$ref": "#/components/schemas/Reference"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          },
          "reviewer_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC, microsecond precision; after database time and within 30 days."
          }
        },
        "required": [
          "workflow",
          "expected_revision",
          "reviewer_id",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "object",
        "properties": {
          "definition_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "definition_hash",
          "expected_revision"
        ],
        "additionalProperties": false
      },
      "Definition": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "const": "independent-processing-workflow-review-v1"
          },
          "author": {
            "$ref": "#/components/schemas/Participant"
          },
          "reviewer": {
            "$ref": "#/components/schemas/Participant"
          },
          "workflow": {
            "$ref": "#/components/schemas/Reference"
          },
          "workflow_revision": {
            "type": "integer",
            "minimum": 1
          },
          "definition": {
            "$ref": "#/components/schemas/TypedWorkflow"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "profile",
          "author",
          "reviewer",
          "workflow",
          "workflow_revision",
          "definition",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Summary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "author_id": {
            "type": "string",
            "format": "uuid"
          },
          "reviewer_id": {
            "type": "string",
            "format": "uuid"
          },
          "workflow_id": {
            "type": "string",
            "format": "uuid"
          },
          "workflow_version": {
            "type": "integer",
            "minimum": 1
          },
          "definition_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "adopted",
              "withdrawn"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "adopted_revision": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "author_id",
          "reviewer_id",
          "workflow_id",
          "workflow_version",
          "definition_hash",
          "state",
          "revision",
          "adopted_revision",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "definition": {
            "$ref": "#/components/schemas/Definition"
          },
          "definition_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "adopted",
              "withdrawn"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "adopted_revision": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "changed_event_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "definition",
          "definition_hash",
          "state",
          "revision",
          "adopted_revision",
          "created_at",
          "changed_event_id"
        ],
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "properties": {
          "reviews": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Summary"
            }
          },
          "next": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "reviews"
        ],
        "additionalProperties": false
      },
      "ApprovedWorkflow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "definition_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "type": "string",
            "const": "approved"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "approval_authority": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "version",
          "definition_hash",
          "state",
          "revision",
          "approval_authority"
        ],
        "additionalProperties": false
      },
      "Adoption": {
        "type": "object",
        "properties": {
          "review": {
            "$ref": "#/components/schemas/Summary"
          },
          "workflow": {
            "$ref": "#/components/schemas/ApprovedWorkflow"
          }
        },
        "required": [
          "review",
          "workflow"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "resource": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "$ref": "#/components/schemas/Adoption"
              }
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "resource",
          "replayed"
        ],
        "additionalProperties": false
