{
  "openapi": "3.1.0",
  "info": {
    "title": "freightctl independent processing workflow review",
    "version": "independent-processing-workflow-review-v1",
    "description": "Definition-only explicit disclosure and independent decision, followed by separate owner adoption. Cookie mutations require ordinary CSRF protection. No payload, delivery, release or general approval grant. Native runtime qualification remains owed."
  },
