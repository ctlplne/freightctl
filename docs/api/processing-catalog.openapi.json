{
  "openapi": "3.1.0",
  "info": {
    "title": "freightctl owned processing task catalog",
    "version": "processing-workflow-catalog-v1",
    "description": "Latest actor-private processing task versions and independent approval/policy observations. No payload, effect or execution readiness promise; native qualification owed."
  },
  "paths": {
    "/v1/tenants/{tenant}/partners/{partner}/processing-workflows": {
      "get": {
        "operationId": "listProcessingWorkflows",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "partner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized metadata observation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "default": {
            "description": "Ordinary scope/permission/refusal; invalid pagination is invalid_processing_catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Reference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "hash"
        ],
        "additionalProperties": false
      },
      "Entry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "revoked"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "const": "records.project"
          },
          "source_policy_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "output_kind": {
            "type": "string",
            "enum": [
              "csv",
              "json_records"
            ]
          },
          "column_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 128
          },
          "output_policy": {
            "$ref": "#/components/schemas/Reference"
          },
          "approval_current": {
            "type": "boolean",
            "description": "Current configuration/owner/independent-review observation; no input or execution readiness claim."
          },
          "output_policy_current": {
            "type": "boolean",
            "description": "Active policy equals the exact task output-policy reference."
          }
        },
        "required": [
          "id",
          "version",
          "hash",
          "name",
          "state",
          "revision",
          "kind",
          "source_policy_hash",
          "output_kind",
          "column_count",
          "output_policy",
          "approval_current",
          "output_policy_current"
        ],
        "additionalProperties": false
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "const": "processing-workflow-catalog-v1"
          },
          "authority_revision": {
            "type": "integer",
            "minimum": 1
          },
          "namespace_root_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "workflows": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "next": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "profile",
          "authority_revision",
          "namespace_root_digest",
          "workflows"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "browserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-freightctl-session"
      }
    }
  }
}
