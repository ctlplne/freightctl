          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "approval_authority": {
            "type": "integer",
            "const": 0
          }
        },
        "required": [
          "id",
          "version",
          "definition",
          "definition_hash",
          "state",
          "revision",
          "approval_authority"
        ],
        "additionalProperties": false
      },
      "Record": {
        "type": "object",
        "properties": {
          "profile": {
            "const": "producer-processing-output-policy-v1"
          },
          "policy": {
            "$ref": "#/components/schemas/Configuration"
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          },
          "observation": {
            "type": "string"
          },
          "ingress_changed": {
            "const": false
          },
          "usage": {
            "const": "contract-registration-only"
          }
        },
        "required": [
          "profile",
          "policy",
          "binding",
          "observation",
          "ingress_changed",
          "usage"
        ],
        "additionalProperties": false
      },
      "View": {
        "type": "object",
        "properties": {
          "profile": {
            "const": "producer-processing-output-policy-v1"
          },
          "policy": {
            "$ref": "#/components/schemas/Configuration"
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          },
          "observation": {
