{
  "openapi": "3.1.0",
  "info": {
    "title": "freightctl governed record projection review",
    "version": "1",
    "description": "Metadata review only. Durable approval and execution are not implemented by this route. PostgreSQL and served client qualification remain owed. Schemas describe structure; live authority, exact source mappings, protected proofs and actual output acceptance require the ordinary services."
  },
  "paths": {
    "/v1/tenants/{tenant}/partners/{partner}/checks/{file}/projection-preview": {
      "parameters": [
        {
          "in": "path",
          "name": "tenant",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ID"
          }
        },
        {
          "in": "path",
          "name": "partner",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ID"
          }
        },
        {
          "in": "path",
          "name": "file",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/ID"
          }
        }
      ],
      "post": {
        "operationId": "previewRecordProjection",
        "summary": "Review exact source proof and separate held output requirements",
        "description": "Requires root admin, read, write, intake_manage, check_run, check_release and original acceptance ownership. Source must have passed or released checks with live mandatory protections. A retired source contract is usable only for explicitly authorized processing; ordinary download policy stays unchanged. No payload is opened, no intent or artifact is written, and no model or scanner daemon is contacted. 32 KiB strict JSON, depth 16, 4096 tokens; unknown, duplicate/case-folded fields and trailing values refuse. Receiving alone grants no processing, forwarding or release authority.",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectionOptions"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact metadata review; not an approved execution or receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectionPreview"
                }
              }
            }
          },
          "400": {
            "description": "Malformed or incompatible mapping, output policy, reason or target."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Processing authority or root scope missing."
          },
          "404": {
            "description": "Source not visible to the authenticated owner."
          },
          "409": {
            "description": "Source proof, policy, storage, namespace or authority is unavailable or stale."
          },
          "500": {
            "description": "Internal operation failed without granting authority."
          }
        }
      }
    }
  },
