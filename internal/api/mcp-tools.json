  {
    "name": "freightctl.prepare_exchange",
    "description": "Validate a metadata review; no offer, reservation or physical byte verification",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/ExchangeRequest"
        }
      },
      "required": [
        "request"
      ],
      "$defs": {
        "ID": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "SHA256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_revision_id": {
              "$ref": "#/$defs/ID"
            },
            "size_bytes": {
              "type": "integer",
              "format": "int64",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "sha256": {
              "$ref": "#/$defs/SHA256"
            },
            "acceptance_policy": {
              "type": "string",
              "pattern": "^(integrity-only-v1|intake-csv-v1:[0-9a-f]{64})$"
            }
          },
          "required": [
            "file_revision_id",
            "size_bytes",
            "sha256",
            "acceptance_policy"
          ]
        },
        "EndpointReference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/ID"
            },
            "revision": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "hash": {
              "$ref": "#/$defs/SHA256"
            }
          },
          "required": [
            "id",
            "revision",
            "hash"
          ]
        },
        "ExchangeRequest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "artifact": {
              "$ref": "#/$defs/Artifact"
            },
            "endpoint": {
              "$ref": "#/$defs/EndpointReference"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6}0*)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "description": "Exact microsecond instant; harmless trailing fractional zeroes and equivalent offsets normalize to UTC. Admission uses database time and configured lifetime."
            },
            "receipt": {
              "type": "string",
              "const": "availability-only-v1"
            },
            "reply_to": {
              "$ref": "#/$defs/ID"
            }
          },
          "required": [
            "schema_version",
            "artifact",
            "endpoint",
            "expires_at",
            "receipt"
          ]
        },
        "ExchangeClosureCommand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "exchange_id": {
              "$ref": "#/$defs/ID"
            },
            "request_hash": {
              "$ref": "#/$defs/SHA256"
            },
            "operation": {
              "enum": [
                "cancel",
                "decline"
              ]
            }
          },
          "required": [
            "schema_version",
            "exchange_id",
            "request_hash",
            "operation"
          ]
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
